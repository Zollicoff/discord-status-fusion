# Discord Status Fusion v1.0
# AI-curated Discord Rich Presence configuration

# Discord Application Configuration (Required)
# Get your Application ID from: https://discord.com/developers/applications
DISCORD_CLIENT_ID=your_discord_application_id_here

# AI Curation (Optional; rule-based fallback is used without a key)
LLM_ENABLED=true
GEMINI_MODEL=gemini-2.5-flash-lite

# Prefer macOS Keychain: security add-generic-password -U -s "GEMINI_API_KEY" -a "$(whoami)" -w "your-api-key"
# On any platform, you may instead set the key here. Never commit your .env file.
# GEMINI_API_KEY=your-api-key

# Update Intervals (Optional)
# UPDATE_INTERVAL: How often to check for app/music changes (in milliseconds)
# Default: 10000 (10 seconds)
UPDATE_INTERVAL=10000

# FORCE_UPDATE_INTERVAL: Maximum time between status updates regardless of changes (in milliseconds)
# Default: 300000 (5 minutes)
FORCE_UPDATE_INTERVAL=300000

# Logging Configuration (Optional)
# Available levels: error, warn, info, debug, verbose
LOG_LEVEL=info
