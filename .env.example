# Discord Status Fusion configuration
# Copy to .env in the project folder (or point DSF_ENV_FILE at another file).

# Required: your Discord application ID.
# Create one at https://discord.com/developers/applications — its name is what
# Discord shows as "Playing <name>", so pick something like "Status Fusion".
DISCORD_CLIENT_ID=your_discord_application_id_here

# How often to sample apps, focus, and music (milliseconds, minimum 1000).
UPDATE_INTERVAL=10000

# Hide app activity after this long without keyboard or mouse input
# (milliseconds; 0 disables). Music still shows while you are away.
IDLE_TIMEOUT=600000

# How quickly focus time fades (milliseconds). Lower values react faster to
# switching apps; higher values keep the status steadier.
FOCUS_HALF_LIFE=600000

# Maximum number of apps on the status line (1-6).
MAX_APPS=3

# Show the current Apple Music / Spotify (macOS) or MPRIS player (Linux) track.
SHOW_MUSIC=true

# Never show these apps (comma-separated names or ids), e.g. HIDE_APPS=Safari,Notion
HIDE_APPS=

# What the member list shows next to your name:
#   details = the activity ("Building with AI"), state = the app list,
#   name = your Discord application's name.
STATUS_DISPLAY=details

# Optional images. LARGE_IMAGE is an https URL or a Discord asset key and
# defaults to the project icon. APP_ICON_URL enables per-app icons from your
# own host, with {id} replaced by the app id (see src/core/app-catalog.js).
# LARGE_IMAGE=
# APP_ICON_URL=https://example.com/icons/{id}.png

# error, warn, info, debug, or verbose
LOG_LEVEL=info
