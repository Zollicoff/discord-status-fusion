{
  "name": "discord-status-fusion",
  "version": "1.0.0",
  "description": "AI-curated Discord Rich Presence for active professional apps and music.",
  "main": "main.js",
  "bin": {
    "dsf": "./bin/dsf"
  },
  "files": [
    ".env.example",
    "bin/",
    "docs/ARCHITECTURE.md",
    "main.js",
    "src/"
  ],
  "scripts": {
    "start": "node main.js",
    "start:daemon": "node bin/dsf start",
    "stop:daemon": "node bin/dsf stop",
    "restart:daemon": "node bin/dsf restart",
    "dev": "nodemon main.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --test test/*.spec.js",
    "test:watch": "node --test --watch test/*.spec.js",
    "check": "npm run lint && npm test && npm audit --audit-level=high --omit=dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zollicoff/discord-status-fusion.git"
  },
  "keywords": [
    "discord",
    "rich-presence",
    "developer-tools",
    "multi-app",
    "fusion",
    "gemini",
    "llm",
    "smart-status",
    "productivity",
    "automation"
  ],
  "author": "Zollicoff",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Zollicoff/discord-status-fusion/issues"
  },
  "homepage": "https://github.com/Zollicoff/discord-status-fusion#readme",
  "dependencies": {
    "discord-rpc": "^4.0.1",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "nodemon": "^3.1.14"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
