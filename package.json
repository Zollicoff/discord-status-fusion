{
  "name": "discord-status-fusion",
  "version": "2.0.0",
  "description": "Discord Rich Presence that shows what you are actually working on: focus-ranked apps, music, and idle detection, with zero runtime dependencies.",
  "main": "main.js",
  "bin": {
    "dsf": "./bin/dsf"
  },
  "files": [
    ".env.example",
    "bin/",
    "docs/ARCHITECTURE.md",
    "main.js",
    "src/"
  ],
  "scripts": {
    "start": "node main.js",
    "preview": "node bin/dsf preview",
    "dev": "node --watch main.js --verbose",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --test test/*.spec.js",
    "test:watch": "node --test --watch test/*.spec.js",
    "check": "npm run lint && npm test && npm audit --audit-level=high --omit=dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zollicoff/discord-status-fusion.git"
  },
  "keywords": [
    "discord",
    "rich-presence",
    "discord-rpc",
    "developer-tools",
    "focus-tracking",
    "productivity",
    "status",
    "daemon",
    "macos",
    "linux",
    "windows"
  ],
  "author": "Zollicoff",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Zollicoff/discord-status-fusion/issues"
  },
  "homepage": "https://github.com/Zollicoff/discord-status-fusion#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "globals": "^17.9.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
